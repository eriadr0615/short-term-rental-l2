@model IList<Inmobiliaria.Models.InformeReserva>

@{
    ViewData["Title"] = "Reservas próximas a finalizar";
}

<div class="container mt-4">
    <h2 class="mb-4">
        Reservas próximas a finalizar
    </h2>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="get" asp-controller="Informe" asp-action="FinReserva" class="row g-2 mb-4">

        <div class="col-md-4">
            <label class="form-label">
                Próximos dias
            </label>
            <input type="number" name="dias" value="@ViewBag.Dias" class="form-control" min="1" placeholder="Ejemplo: 7"
                   required />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>
    </form>

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Reserva</th>
                    <th>Inquilino</th>
                    <th>Inmueble</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Monto diario</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdReserva</td>
                        <td>@item.Inquilino</td>
                        <td>@item.Inmueble</td>
                        <td>
                            @item.FechaInicio.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @item.FechaFin.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            $ @item.MontoDia
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        @if (ViewBag.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination">

                    @for (
                        int i = 1;
                        i <= ViewBag.TotalPaginas;
                        i++)
                    {
                        <li class="page-item
                            @(i == ViewBag.Pagina ? "active" : "")">

                            <a class="page-link" asp-controller="Informe" asp-action="FinReserva" asp-route-dias="@ViewBag.Dias"
                               asp-route-pagina="@i">
                                @i
                            </a>

                        </li>
                    }

                </ul>
            </nav>
        }
    }
    else if (ViewBag.BusquedaRealizada == true)
    {
        <div class="alert alert-info">
            No se encontraron reservas que finalicen dentro de ese periodo
        </div>
    }

    <a asp-controller="Informe" asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>
