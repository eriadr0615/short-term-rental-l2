@{
    ViewData["Title"] = "Informes";
}

<div class="container mt-4">

    <h2 class="mb-4">Informes</h2>
    <div class="list-group">
        <a asp-controller="Informe"
           asp-action="Inmueble"
           class="list-group-item list-group-item-action">
            Inmuebles y propietarios
        </a>

        <a asp-controller="Informe"
            asp-action="MasReservado"
            class="list-group-item list-group-item-action">
            Inmuebles mas reservados en los ultimos 365 dias
        </a>

        <a asp-controller="Informe"
            asp-action="Propietario"
            class="list-group-item list-group-item-action">
              Inmuebles por propietario
        </a>

        <a asp-controller="Informe"
            asp-action="SinReserva"
            class="list-group-item list-group-item-action">
             Inmuebles sin reservas en los últimos dias
        </a>

        <a asp-controller="Informe"
            asp-action="Reserva"
            class="list-group-item list-group-item-action">
                Reservas vigentes
            </a>

        <a asp-controller="Informe"
            asp-action="FinReserva"
            class="list-group-item list-group-item-action">
            Reservas que finalizan en los próximos dias
            </a>

    </div>
</div>