@model IList<Inmobiliaria.Models.InformeInmueble>

@{
    ViewData["Title"] = "Informe de inmuebles";
}

<div class="container mt-4">
    <h2 class="mb-4"> Inmuebles y propietarios </h2>

    <form method="get"
          asp-controller="Informe" asp-action="Inmueble"
          class="row g-2 mb-4">
        <div class="col-md-4">

            <label class="form-label">
                Disponibilidad
            </label>

            <select name="disponible"
                    class="form-select">
                <option value="">
                    Todos
                </option>
                <option value="true">
                    Disponibles
                </option>
                <option value="false">
                    No disponibles
                </option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>
        </div>
    </form>


    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Direccion</th>
                <th>Tipo</th>
                <th>Propietario</th>
                <th>Capacidad max de personas</th>
                <th>Precio diario</th>
                <th>Disponible</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Direccion
                    </td>
                    <td>
                        @item.TipoInmueble
                    </td>
                    <td>
                        @item.Propietario
                    </td>
                    <td>
                        @item.CapacidadMaxima
                    </td>
                    <td>
                        $ @item.PrecioDiario
                    </td>
                    <td>

                        @if (item.Disponible)
                        {
                            <span class="badge bg-success">
                                Si
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                No
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Paginacion" />
</div>
