@model IList<Inmobiliaria.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles mas reservados";
}

<div class="container mt-4">

    <h2 class="mb-4">
        Inmuebles mas reservados
    </h2>

    <p class="text-muted">
        Reservas registradas durante el ultimo año
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Propietario</th>
                    <th>Cantidad de reservas</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Direccion</td>
                        <td>@item.TipoInmueble</td>
                        <td>@item.Propietario</td>
                        <td>@item.CantidadReservas</td>
                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="alert alert-info">
            Ups, no se encontraron reservas en los ultimos 365 dias.
        </div>
    }

    <partial name="_Paginacion" />

    <a asp-controller="Informe"
       asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>
