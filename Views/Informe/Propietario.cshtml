@model IList<Inmobiliaria.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles por propietario";
}

<div class="container mt-4">
    <h2 class="mb-4">Inmuebles por propietario</h2>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="get" asp-controller="Informe" asp-action="Propietario" class="row g-2 mb-4">

        <div class="col-md-4">
            <label class="form-label">
                DNI del propietario
            </label>
            <input type="text" name="dni" value="@ViewBag.Dni" class="form-control" placeholder="Ingrese DNI"
                   required />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>

    </form>

    @if (Model.Count > 0)
    {
        <div class="mb-3">
            <strong>Propietario:</strong>
            @Model[0].Propietario
        </div>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Capacidad máxima</th>
                    <th>Precio diario</th>
                    <th>Disponible</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Direccion</td>
                        <td>@item.TipoInmueble</td>
                        <td>@item.CapacidadMaxima</td>
                        <td>$ @item.PrecioDiario</td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">
                                    Sí
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    No
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (ViewBag.BusquedaRealizada == true)
    {
        <div class="alert alert-info">
            No se encontraron inmuebles para ese propietario
        </div>
    }
    <partial name="_Paginacion" />
    <a asp-controller="Informe" asp-action="Index" class="btn btn-secondary">
        Volver
    </a>





</div>
