@model IList<Inmobiliaria.Models.InformeReserva>

@{
    ViewData["Title"] = "Reservas vigentes";
}

<div class="container mt-4">
    <h2 class="mb-4">
        Reservas vigentes
    </h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Reserva</th>
                    <th>Inquilino</th>
                    <th>Inmueble</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Monto diario</th>
                </tr>
            </thead>
            <tbody>



                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdReserva</td>
                        <td>@item.Inquilino</td>
                        <td>@item.Inmueble</td>
                        <td>
                            @item.FechaInicio.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @item.FechaFin.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            $ @item.MontoDia
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (ViewBag.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination">
                    @for (
                        int i = 1;
                        i <= ViewBag.TotalPaginas;
                        i++)
                    {
                        <li class="page-item
                            @(i == ViewBag.Pagina ? "active" : "")">

                            <a class="page-link"
                               asp-controller="Informe"
                               asp-action="Reserva"
                               asp-route-pagina="@i">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            No hay reservas vigentesa la fecha
        </div>
    }
        <a asp-controller="Informe"
        asp-action="Index"
        class="btn btn-secondary">
            Volver
        </a>
</div>