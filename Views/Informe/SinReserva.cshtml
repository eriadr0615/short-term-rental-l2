@model IList<Inmobiliaria.Models.InformeInmueble>

@{
    ViewData["Title"] = "Inmuebles sin reservas";
}

<div class="container mt-4">

    <h2 class="mb-4">
        Inmuebles sin reservas
    </h2>
    <p class="text-muted">
        Buscar inmuebles sin reservas recientes
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="get" asp-controller="Informe" asp-action="SinReserva" class="row g-2 mb-4">

        <div class="col-md-4">
            <label class="form-label">
                Cantidad de dias
            </label>

            <input type="number" name="dias" value="@ViewBag.Dias" class="form-control" min="1"
                   placeholder="Ejemplo: 30" required />

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>
    </form>

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Direccion</th>
                    <th>Tipo</th>
                    <th>Propietario</th>
                    <th>Capacidad maxima de personas</th>
                    <th>Precio diario</th>
                    <th>Disponible</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Direccion</td>
                        <td>@item.TipoInmueble</td>
                        <td>@item.Propietario</td>
                        <td>@item.CapacidadMaxima</td>
                        <td>$ @item.PrecioDiario</td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">
                                    Sí
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    No
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (ViewBag.BusquedaRealizada == true)
    {
        <div class="alert alert-info">
            No hay inmuebles desocupados en las fechas seleccionadas
        </div>
    }
    <a asp-controller="Informe" asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>