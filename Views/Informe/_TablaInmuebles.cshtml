@model IList<Inmobiliaria.Models.InformeInmueble>

@if (ViewData.ModelState.IsValid)
{
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No se encontraron inmuebles para esta consulta.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Dirección</th><th>Tipo</th><th>Propietario</th>
                        <th>Capacidad máxima</th><th>Precio diario</th><th>Disponible</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-controller="Inmueble" asp-action="Details" asp-route-id="@item.IdInmueble">@item.Direccion</a></td>
                            <td>@item.TipoInmueble</td>
                            <td>@item.Propietario</td>
                            <td>@item.CapacidadMaxima</td>
                            <td>@item.PrecioDiario.ToString("C")</td>
                            <td>@(item.Disponible ? "Sí" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Paginacion" />
}
