@model Inmobiliaria.Models.Inmueble

@{
    var propietarioActual = ViewBag.PropietarioActual as Inmobiliaria.Models.Propietario;
    var tipos = ViewBag.TiposInmueble as IList<Inmobiliaria.Models.TipoInmueble>
        ?? new List<Inmobiliaria.Models.TipoInmueble>();
}

<h1>Editar inmueble</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="IdInmueble" />

    <div class="form-group">
        <label>Propietario</label>
        <input id="buscar-propietario" class="form-control mb-1"
               placeholder="Escriba al menos 2 caracteres para buscar" autocomplete="off" />
        <select asp-for="IdPropietario" id="propietario" class="form-select">
            <option value="">Seleccione un propietario</option>
            @if (propietarioActual != null)
            {
                <option value="@propietarioActual.IdPropietario" selected>
                    @propietarioActual.Nombre @propietarioActual.Apellido - DNI @propietarioActual.Dni
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="DireccionInmueble"></label>
        <input asp-for="DireccionInmueble" class="form-control" />
        <span asp-validation-for="DireccionInmueble"></span>
    </div>

    <div class="form-group">
        <label>Tipo de inmueble</label>

        <select asp-for="IdTipoInmueble" class="form-control">
            <option value="">Seleccione un tipo de inmueble</option>

            @foreach (var tipo in tipos)
            {
                <option value="@tipo.IdTipoInmueble">
                    @tipo.NombreTipo
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="CoordenadasInmuebles"></label>
        <input asp-for="CoordenadasInmuebles" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PrecioDiario"></label>
        <input asp-for="PrecioDiario" class="form-control"
               placeholder="Ingrese solo el numero. Ej: 30000" />
        <span asp-validation-for="PrecioDiario"></span>
    </div>

    <div class="form-group">
        <label asp-for="PorcentajeReserva"></label>
        <input asp-for="PorcentajeReserva" class="form-control"
               placeholder="Ingrese solo el numero. Ej: 5" />
        <span asp-validation-for="PorcentajeReserva"></span>
    </div>

    <div class="form-group">
        <label asp-for="CapacidadMaxima"></label>
        <input asp-for="CapacidadMaxima" class="form-control"
               placeholder="Ingrese solo el numero. Ej: 2" />
        <span asp-validation-for="CapacidadMaxima"></span>
    </div>

    <div class="form-group">
        <label asp-for="Disponible"></label>
        <input asp-for="Disponible" type="checkbox" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BusquedaAjaxScripts" />
    <script>
        configurarBusquedaAjax(
            "#buscar-propietario",
            "#propietario",
            "@Url.Action("Buscar", "Propietarios")");
    </script>
}
