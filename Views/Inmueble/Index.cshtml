@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
    var tipos = ViewBag.TiposInmueble as IList<Inmobiliaria.Models.TipoInmueble>
        ?? new List<Inmobiliaria.Models.TipoInmueble>();
}


<h1>Inmuebles</h1>

<p>
    <a asp-action="Create">Crear un nuevo inmueble</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por dirección o tipo" />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Tipo de inmueble</th>
            <th>Direccion</th>
            <th>Capacidad</th>
            <th>Precio de estadia diario</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            //se agrega de esta forma p/visualizar el tipo de inmueble en detalles, resolver mas formal posteriormente
            var nombreTipo = "";

            foreach (var tipo in tipos)
            {
                if (tipo.IdTipoInmueble == item.IdTipoInmueble)
                {
                    nombreTipo = tipo.NombreTipo;
                }
            }

            <tr>
                <td>@nombreTipo</td>
                <td>@item.DireccionInmueble</td>
                <td>@item.CapacidadMaxima</td>
                <td>@item.PrecioDiario</td>
                <td>@item.Disponible</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.IdInmueble">
                        Detalle
                    </a> -
                    <a asp-action="Edit" asp-route-id="@item.IdInmueble">
                        Modificar
                    </a>
                    @if (User.IsInRole(Usuario.RolAdministrador))
                    {
                        <span> - </span>
                        <a asp-action="Eliminar" asp-route-id="@item.IdInmueble">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>


        
        
        }
    </tbody>
</table>

<partial name="_Paginacion" />
