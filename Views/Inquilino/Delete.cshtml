@model Inmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Eliminar inquilino";
}

<h1>Eliminar inquilino</h1>

<h3> Seguro que desea eliminar este inquilino?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Dni)</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>
        <dt class="col-sm-2">Apellido</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Apellido)</dd>
        <dt class="col-sm-2">Telefono</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Telefono)</dd>
        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Correo)</dd>
        <dt class="col-sm-2">Direccion</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Direccion)</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.IdInquilino">
        <input type="hidden" asp-for="IdInquilino" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
