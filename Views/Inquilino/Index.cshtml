@model IEnumerable<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1>Inquilinos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo inquilino</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por DNI, nombre, apellido o correo" />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Telefono</th>
            <th>Correo</th>
            <th>Direccion</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.IdInquilino" class="btn btn-secondary">Detalle</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdInquilino" class="btn btn-warning">Editar</a>
                    @if (User.IsInRole(Usuario.RolAdministrador))
                    {
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.IdInquilino" class="btn btn-danger">Eliminar</a>
                    }
                </td>
            </tr>

        
        }
    </tbody>
</table>

<partial name="_Paginacion" />
