@model Pago

@{
    ViewData["Title"] = "Registrar pago";
    var reservaActual = ViewBag.ReservaActual as Reserva;
}

<h1>Registrar pago</h1>

@if (ViewBag.MontoMinimo != null)
{
    <div class="alert alert-info">
        El inmueble requiere una seña del @ViewBag.PorcentajeReserva%.
        El primer pago debe ser de al menos <strong>@(((decimal)ViewBag.MontoMinimo).ToString("C"))</strong>.
    </div>
}

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="IdReserva" class="form-label">Reserva</label>
                <input id="buscar-reserva" class="form-control mb-1"
                       placeholder="Buscar por número, inquilino, DNI o inmueble"
                       autocomplete="off" />
                <select asp-for="IdReserva" id="reserva" class="form-select">
                    <option value="0">Seleccione una reserva</option>
                    @if (reservaActual != null)
                    {
                        <option value="@reservaActual.IdReserva" selected>
                            Reserva #@reservaActual.IdReserva
                        </option>
                    }
                </select>
                <span asp-validation-for="IdReserva" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label"></label>
                <input asp-for="Concepto" class="form-control" />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label">Fecha de pago</label>
                <input asp-for="FechaPago" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Monto" class="form-label"></label>
                <input asp-for="Monto" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registrar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BusquedaAjaxScripts" />
    <script>
        configurarBusquedaAjax(
            "#buscar-reserva",
            "#reserva",
            "@Url.Action("Buscar", "Reservas")", null, 1);
    </script>
}
