@model Pago

@{
    ViewData["Title"] = "Registrar pago";
    var reservas = ViewBag.Reservas as IList<Reserva> ?? new List<Reserva>();
    var inquilinos = ViewBag.Inquilinos as IList<Inquilino> ?? new List<Inquilino>();
    var inmuebles = ViewBag.Inmuebles as IList<Inmueble> ?? new List<Inmueble>();
}

<h1>Registrar pago</h1>

@if (ViewBag.MontoMinimo != null)
{
    <div class="alert alert-info">
        El inmueble requiere una seña del @ViewBag.PorcentajeReserva%.
        El primer pago debe ser de al menos <strong>@(((decimal)ViewBag.MontoMinimo).ToString("C"))</strong>.
    </div>
}

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="IdReserva" class="form-label">Reserva</label>
                <select asp-for="IdReserva" class="form-select">
                    <option value="0">Seleccione una reserva</option>
                    @foreach (var reserva in reservas)
                    {
                        var inquilino = inquilinos.FirstOrDefault(i => i.IdInquilino == reserva.IdInquilino);
                        var inmueble = inmuebles.FirstOrDefault(i => i.IdInmueble == reserva.IdInmueble);
                        <option value="@reserva.IdReserva">
                            #@reserva.IdReserva - @(inquilino == null ? "Inquilino no encontrado" : $"{inquilino.Nombre} {inquilino.Apellido}") - @(inmueble?.DireccionInmueble ?? "Inmueble no encontrado")
                        </option>
                    }
                </select>
                <span asp-validation-for="IdReserva" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label"></label>
                <input asp-for="Concepto" class="form-control" />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label">Fecha de pago</label>
                <input asp-for="FechaPago" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Monto" class="form-label"></label>
                <input asp-for="Monto" class="form-control" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registrar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
