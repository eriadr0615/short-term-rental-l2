@model IEnumerable<Inmobiliaria.Models.Propietario>

<h1>Propietarios</h1>

<a asp-action="Create" class="btn btn-primary">Nuevo propietario</a>

<form method="get" class="row g-2 mt-2 mb-3">
    <div class="col-md-5">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por DNI, nombre, apellido o correo" />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table mt-3">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Dirección</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>
                <td>@item.Direccion</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdPropietario" class="btn btn-secondary">Detalle</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdPropietario" class="btn btn-warning"> Editar
                    </a>
                    @if (User.IsInRole(Usuario.RolAdministrador))
                    {
                        <a asp-action="Eliminar" asp-route-id="@item.IdPropietario" class="btn btn-danger">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>
        
        }
    </tbody>
</table>

<partial name="_Paginacion" />
