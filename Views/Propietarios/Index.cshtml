@model IEnumerable<Inmobiliaria.Models.Propietario>

<h1>Propietarios</h1>

<a asp-action="Create" class="btn btn-primary">Nuevo propietario</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Dirección</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>
                <td>@item.Direccion</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdPropietario"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@item.IdPropietario"
                       class="btn btn-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>