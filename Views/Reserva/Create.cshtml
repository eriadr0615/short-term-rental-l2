@model Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
    var inquilinoActual = ViewBag.InquilinoActual as Inmobiliaria.Models.Inquilino;
    var inmuebleActual = ViewBag.InmuebleActual as Inmobiliaria.Models.Inmueble;
}

<h1>Nueva reserva</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Inquilino</label>
                <input id="buscar-inquilino" class="form-control mb-1"
                       placeholder="Buscar por nombre, apellido o DNI" autocomplete="off" />
                <select asp-for="IdInquilino" id="inquilino" class="form-select">
                    <option value="">Seleccione un inquilino</option>
                    @if (inquilinoActual != null)
                    {
                        <option value="@inquilinoActual.IdInquilino" selected>
                            @inquilinoActual.Nombre @inquilinoActual.Apellido - DNI @inquilinoActual.Dni
                        </option>
                    }
                </select>
                <span asp-validation-for="IdInquilino" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Inmueble</label>
                <input id="buscar-inmueble" class="form-control mb-1"
                       placeholder="Buscar por dirección" autocomplete="off" />
                <select asp-for="IdInmueble" id="inmueble" class="form-select">
                    <option value="">Seleccione un inmueble</option>
                    @if (inmuebleActual != null)
                    {
                        <option value="@inmuebleActual.IdInmueble" selected>
                            @inmuebleActual.DireccionInmueble
                        </option>
                    }
                </select>
                <span asp-validation-for="IdInmueble" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaInicio" class="form-label">Fecha de inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaFinOriginal" class="form-label">Fecha de fin</label>
                <input asp-for="FechaFinOriginal" type="date" class="form-control" />
                <span asp-validation-for="FechaFinOriginal" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MontoDia" class="form-label">Monto por día</label>
                <input asp-for="MontoDia" class="form-control" />
                <span asp-validation-for="MontoDia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BusquedaAjaxScripts" />
    <script>
        configurarBusquedaAjax(
            "#buscar-inquilino",
            "#inquilino",
            "@Url.Action("Buscar", "Inquilinos")");

        configurarBusquedaAjax(
            "#buscar-inmueble",
            "#inmueble",
            "@Url.Action("Buscar", "Inmueble")",
            function () {
                return {
                    fechaInicio: $("#FechaInicio").val(),
                    fechaFin: $("#FechaFinOriginal").val()
                };
            });
    </script>
}
