@model Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Detalle de reserva";
}

<h1>Detalle de reserva</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Reserva</dt>
        <dd class="col-sm-10">@Model.IdReserva</dd>
        <dt class="col-sm-2">Inquilino</dt>
        <dd class="col-sm-10">@Model.IdInquilino</dd>
        <dt class="col-sm-2">Inmueble</dt>
        <dd class="col-sm-10">@Model.IdInmueble</dd>
        <dt class="col-sm-2">Fecha de inicio</dt>
        <dd class="col-sm-10">@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-2">Fecha de fin</dt>
        <dd class="col-sm-10">@Model.FechaFinOriginal.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-2">Monto por día</dt>
        <dd class="col-sm-10">@Model.MontoDia</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
