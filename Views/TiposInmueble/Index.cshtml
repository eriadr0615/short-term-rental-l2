@model IEnumerable<Inmobiliaria.Models.TipoInmueble>

<h1>Tipo de inmueble</h1>

<p>
    <a asp-action="Create"> crear un nuevo tipo de inmueble</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar tipo de inmueble" />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Tipo de inmueble</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreTipo</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdTipoInmueble">
                        Detalle
                    </a>
                    |
                    <a asp-action="Edit" asp-route-id="@item.IdTipoInmueble">
                        Modificar
                    </a>
                    @if (User.IsInRole(Usuario.RolAdministrador))
                    {
                        <span> | </span>
                        <a asp-action="Eliminar" asp-route-id="@item.IdTipoInmueble">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>


        }
    </tbody>
</table>

<partial name="_Paginacion" />
